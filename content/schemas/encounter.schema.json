{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Ashen Reach Encounter", "type": "object", "additionalProperties": false,
  "required": ["id", "name", "enemies"],
  "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" }, "name": { "type": "string" }, "enemies": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["enemy_id", "count"], "properties": { "enemy_id": { "type": "string" }, "count": { "type": "integer", "minimum": 1 } } } } }
}
